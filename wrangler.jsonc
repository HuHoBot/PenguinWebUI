{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "penguin-webui",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/ws", "/ws/*"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://webui.example.com"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHANNELS", "class_name": "EditorChannel" },
      { "name": "SESSIONS", "class_name": "BrowserSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EditorChannel", "BrowserSession"] }
  ]
}
