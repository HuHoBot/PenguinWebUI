{
  "name": "penguin-webui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8088 --var PUBLIC_ORIGIN:http://127.0.0.1:8088",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "test": "node --import tsx --test src/worker/*.test.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261118.0-beta",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "wrangler": "4.165.0",
    "ws": "^8.18.0"
  }
}
